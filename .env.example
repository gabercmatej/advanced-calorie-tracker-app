# CalAI environment variables — copy to `.env.local` and fill in.
#
# Expo only reads variables prefixed EXPO_PUBLIC_, and every one of them is
# INLINED INTO THE CLIENT BUNDLE. Treat this whole prefix as public: anything
# here ends up readable by anyone who has the app or the web build.
#
# Nothing secret belongs in this file. There are exactly two values, and both
# are meant to be public.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# The **publishable** key (sb_publishable_... , or the older eyJ... anon JWT).
# Safe to ship: row-level security (supabase/schema.sql) is what protects the
# data, not the secrecy of this key.
#
# NEVER put an `sb_secret_...` key here. It bypasses RLS entirely, and the app
# refuses to start cloud sync if it finds one.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# The Anthropic key is deliberately NOT here.
#
# It lives as a Supabase secret behind the `claude` Edge Function, which checks
# the caller's session and rate-limits per user before forwarding to Anthropic:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase functions deploy claude
#
# If you find EXPO_PUBLIC_ANTHROPIC_API_KEY in a .env file, delete it and rotate
# the key — every build made while it was there has it embedded.
# ---------------------------------------------------------------------------
